// Document model; everything not set by a migration is nullable/INFERRED. The unique
// (application_id, program_id, category) survives from the 2025_08_11 migration (NULLs allowed).
model Document {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt?   @map("user_id") // INFERRED
  applicationId    BigInt?   @map("application_id")
  programId        BigInt?   @map("program_id")
  templateId       BigInt?   @map("template_id") // INFERRED
  currentVersionId BigInt?   @map("current_version_id")
  folderId         BigInt?   @map("folder_id")
  title            String? // INFERRED
  category         String?
  type             String    @default("document") // document, file_upload
  content          Json? // INFERRED
  metadata         Json? // INFERRED
  language         String? // INFERRED
  wordCount        Int?      @default(0) @map("word_count") // INFERRED
  readabilityScore Decimal?  @map("readability_score") @db.Decimal(5, 2) // INFERRED
  isAiGenerated    Boolean   @default(false) @map("is_ai_generated")
  status           String? // INFERRED
  path             String? // INFERRED
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")
  deletedAt        DateTime? @map("deleted_at") // INFERRED (model casts deleted_at)

  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  program        Program?          @relation(fields: [programId], references: [id], onDelete: Cascade)
  template       Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
