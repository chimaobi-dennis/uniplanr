// Prisma schema (PostgreSQL / Supabase) reproducing the legacy Laravel 11 MySQL data model.
// Table + column names are kept IDENTICAL to the legacy ones (@@map / @map) so rows can be copied 1:1.
//
// INTENTIONALLY SKIPPED (framework tables): password_reset_tokens, sessions (replaced by Auth.js),
//   cache, cache_locks, jobs, job_batches, failed_jobs, migrations,
//   Cashier's subscriptions + subscription_items (users keeps the Cashier columns stripe_id, pm_type, ...).
//
// CONVENTIONS
//  - Laravel id()/foreignId() = unsigned bigint -> BigInt. timestamps() are nullable -> DateTime?.
//  - created_at/updated_at are NOT @updatedAt so imported values are preserved; set them in app code.
//  - Laravel enum() columns are modelled as String with the allowed values in a comment.
//  - "INFERRED" = column is NOT created by any migration but is used by app/Models/*.php ($fillable/$casts).
//    The legacy migrations drift heavily from the real DB (e.g. `documents` is never created by a migration),
//    so these were added as nullable columns. Verify against the real MySQL schema before importing.
//  - Polymorphic relations (taggables, notifications.related_*) are plain type/id columns without FKs.
//  - Duplicated create migrations resolved to final state: program_likes (2nd definition wins: user_id +
//    program_comment_id), program_replies (identical), blog_categories (identical).
//  - Dead: program_comments.parent_id is added twice (create + alter) -> single column.
//  - Not supported in Prisma: MySQL FULLTEXT index on chatbot_knowledge_base(question, answer, keywords)
//    -> add a Postgres GIN/tsvector index by raw SQL if needed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Users ─────────────────────────

model User {
  id                     BigInt    @id @default(autoincrement())
  name                   String
  email                  String    @unique
  subscriptionTier       String    @default("free") @map("subscription_tier")
  hasAiAccess            Boolean   @default(false) @map("has_ai_access")
  subscriptionExpiresAt  DateTime? @map("subscription_expires_at")
  emailVerifiedAt        DateTime? @map("email_verified_at")
  password               String // bcrypt hash
  twoFactorSecret        String?   @map("two_factor_secret")
  twoFactorRecoveryCodes String?   @map("two_factor_recovery_codes")
  rememberToken          String?   @map("remember_token")
  currentTeamId          BigInt?   @map("current_team_id")
  profilePhotoPath       String?   @map("profile_photo_path") @db.VarChar(2048)
  folders                Json?
  // Cashier customer columns
  stripeId               String?   @map("stripe_id")
  pmType                 String?   @map("pm_type")
  pmLastFour             String?   @map("pm_last_four") @db.VarChar(4)
  trialEndsAt            DateTime? @map("trial_ends_at")
  // credits (2025_08_08 migration wins: the 2025_10_25 one is guarded by hasColumn)
  credits                Decimal   @default(100.0000) @db.Decimal(12, 4)
  creditsUpdatedAt       DateTime? @map("credits_updated_at")
  creditPlan             String    @default("free") @map("credit_plan")
  totalCreditsPurchased  Decimal   @default(0.0000) @map("total_credits_purchased") @db.Decimal(12, 4)
  totalCreditsUsed       Decimal   @default(0.0000) @map("total_credits_used") @db.Decimal(12, 4)
  costOfCreditUsed       Decimal   @default(0) @map("cost_of_credit_used") @db.Decimal(12, 8)
  // INFERRED from User model
  isAdmin                Boolean?
  country                String?
  countryCode            String?   @map("country_code")
  city                   String?
  address                String?
  linkedin               String?
  portfolioLink          String?   @map("portfolio_link")
  about                  String?
  phone                  String?
  education              Json?
  createdAt              DateTime? @map("created_at")
  updatedAt              DateTime? @map("updated_at")

  programComments        ProgramComment[]
  programLikes           ProgramLike[]
  programReplies         ProgramReply[]
  userDocuments          UserDocument[]
  activityLogs           ActivityLog[]
  paymentOrders          PaymentOrder[]
  programRatings         ProgramRating[]
  favoritePrograms       FavoriteProgram[]
  posts                  Post[]
  comments               Comment[]                 @relation("CommentAuthor")
  targetedComments       Comment[]                 @relation("CommentTarget")
  likes                  Like[]
  answers                Answer[]
  answerComments         AnswerComment[]
  answerVotes            AnswerVote[]
  chatMessages           ChatMessage[]
  studentProfiles        StudentProfile[]
  documents              Document[]
  documentVersions       DocumentVersion[]
  documentSharesReceived DocumentShare[]           @relation("DocShareUser")
  documentSharesGiven    DocumentShare[]           @relation("DocShareBy")
  aiGenerationLogs       AiGenerationLog[]
  documentFolders        DocumentFolder[]
  folderSharesReceived   DocumentFolderShare[]     @relation("FolderShareUser")
  folderSharesGiven      DocumentFolderShare[]     @relation("FolderShareBy")
  notifications          Notification[]
  chatbotConversations   ChatbotConversation[]
  blogPosts              BlogPost[]
  promotionSubmissions   PromotionTaskSubmission[] @relation("SubmissionUser")
  reviewedSubmissions    PromotionTaskSubmission[] @relation("SubmissionReviewer")
  promotionCoupons       PromotionCoupon[]
  userActivities         UserActivity[]
  emailLogs              EmailLog[]
  websiteVisits          WebsiteVisit[]
  visitorLocations       VisitorLocation[]
  userSessions           UserSession[]
  websiteEvents          WebsiteEvent[]
  applications           Application[]
  programApplications    ProgramApplication[]
  recommendedPrograms    RecommendedProgram[]

  @@map("users")
}

model StudentProfile {
  id                     BigInt    @id @default(autoincrement())
  userId                 BigInt    @map("user_id")
  degree                 String?
  originCountry          String?   @map("origin_country")
  fields                 String?
  desiredFields          String?   @map("desired_fields")
  language               String?
  languageTestType       String?   @map("language_test_type")
  languageTestScore      String?   @map("language_test_score")
  languageTestYear       String?   @map("language_test_year")
  hasLanguageTest        Boolean   @default(false) @map("has_language_test")
  studyEnvs              String?   @map("study_envs")
  interestKeywords       Json?     @map("interest_keywords")
  recommendedPrograms    Json?     @map("recommended_programs")
  workExperience         String?   @map("work_experience")
  feePreference          String?   @map("fee_preference")
  // INFERRED from StudentProfile model
  areaOfStudy            String?   @map("area_of_study")
  recommendedPercentages Json?     @map("recommended_percentages")
  desiredDegreeType      String?   @map("desired_degree_type")
  universityName         String?   @map("university_name")
  universityCountry      String?   @map("university_country")
  createdAt              DateTime? @map("created_at")
  updatedAt              DateTime? @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    Application[]
  recommendations RecommendedProgram[]

  @@map("student_profiles")
}

