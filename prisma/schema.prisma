  autoVerificationMetadata Json?     @map("auto_verification_metadata")
  autoVerifiedAt           DateTime? @map("auto_verified_at")
  status                   String    @default("pending") // pending, approved, rejected
  notes                    String?
  submittedAt              DateTime  @map("submitted_at")
  reviewedAt               DateTime? @map("reviewed_at")
  reviewedBy               BigInt?   @map("reviewed_by")
  createdAt                DateTime? @map("created_at")
  updatedAt                DateTime? @map("updated_at")

  task     PromotionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User          @relation("SubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?         @relation("SubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([taskId, userId])
  @@index([status])
  @@map("promotion_task_submissions")
}

model PromotionCoupon {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @map("user_id")
  couponCode         String    @unique @map("coupon_code")
  discountPercentage Int       @map("discount_percentage")
  completedTasks     Json      @map("completed_tasks")
  isUsed             Boolean   @default(false) @map("is_used")
  expiresAt          DateTime  @map("expires_at")
  sourceTaskId       BigInt?   @map("source_task_id") // INFERRED
  createdAt          DateTime? @map("created_at")
  updatedAt          DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, couponCode])
  @@index([isUsed])
  @@map("promotion_coupons")
}

// ───────────────────────── Logging / analytics / email ─────────────────────────

model ActivityLog {
  id            BigInt    @id @default(autoincrement())
  name          String
  userId        BigInt    @map("user_id")
  role          String
  ip            String
  location      String
  // INFERRED from ActivityLog model
  description   String?
  type          String?
  applicationId BigInt?   @map("application_id")
  details       String?
  replyParent   BigInt?   @map("reply_parent")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model UserActivity {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  activityType String    @map("activity_type")
  pageUrl      String?   @map("page_url")
  metadata     Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent")
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([userId, activityType])
  @@map("user_activities")
}

model EmailLog {
  id             BigInt    @id @default(autoincrement())
  userId         BigInt    @map("user_id")
  emailType      String    @map("email_type")
  templateName   String    @map("template_name")
  sentAt         DateTime? @map("sent_at")
  openedAt       DateTime? @map("opened_at")
  clickedAt      DateTime? @map("clicked_at")
  status         String    @default("queued") // enum: queued|sent|delivered|opened|clicked|bounced|failed
  metadata       Json?
  brevoMessageId String?   @map("brevo_message_id")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  performance EmailPerformanceMetric[]

  @@index([userId])
  @@index([emailType])
  @@index([status])
  @@index([sentAt])
  @@index([userId, emailType])
  @@index([brevoMessageId])
  @@map("email_logs")
}

model EmailSetting {
  id          BigInt    @id @default(autoincrement())
  key         String    @unique
  value       String?
  type        String    @default("string") // string, integer, boolean, json
  description String?
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("email_settings")
}

model EmailTemplate {
  id              BigInt    @id @default(autoincrement())
  name            String
  emailType       String    @map("email_type")
  brevoTemplateId Int       @map("brevo_template_id")
  description     String?
  parameters      Json?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  @@unique([emailType, brevoTemplateId])
  @@map("email_templates")
}

model EmailTriggerStatus {
  id              BigInt    @id @default(autoincrement())
  triggerType     String    @unique @map("trigger_type")
  isActive        Boolean   @default(true) @map("is_active")
  lastRunAt       DateTime? @map("last_run_at")
  emailsSentToday Int       @default(0) @map("emails_sent_today")
  totalEmailsSent Int       @default(0) @map("total_emails_sent")
  successRate     Decimal   @default(100.00) @map("success_rate") @db.Decimal(5, 2)
  configuration   Json?
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  @@map("email_trigger_status")
}

model EmailAnalytic {
  id              BigInt    @id @default(autoincrement())
  date            DateTime  @db.Date
  emailType       String?   @map("email_type")
  emailsSent      Int       @default(0) @map("emails_sent")
  emailsQueued    Int       @default(0) @map("emails_queued")
  emailsFailed    Int       @default(0) @map("emails_failed")
  emailsOpened    Int       @default(0) @map("emails_opened")
  emailsClicked   Int       @default(0) @map("emails_clicked")
  emailsBounced   Int       @default(0) @map("emails_bounced")
  avgDeliveryTime Decimal?  @map("avg_delivery_time") @db.Decimal(8, 2)
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  @@unique([date, emailType])
  @@index([date, emailType])
  @@map("email_analytics")
}

model EmailPerformanceMetric {
  id             BigInt    @id @default(autoincrement())
  emailLogId     BigInt    @map("email_log_id")
  brevoMessageId String?   @map("brevo_message_id")
  deliveredAt    DateTime? @map("delivered_at")
  openedAt       DateTime? @map("opened_at")
  clickedAt      DateTime? @map("clicked_at")
  bouncedAt      DateTime? @map("bounced_at")
  bounceReason   String?   @map("bounce_reason")
  openCount      Int       @default(0) @map("open_count")
  clickCount     Int       @default(0) @map("click_count")
  trackingData   Json?     @map("tracking_data")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  emailLog EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([brevoMessageId])
  @@index([deliveredAt])
  @@index([openedAt])
  @@index([clickedAt])
  @@map("email_performance_metrics")
}

model EmailRateLimit {
  id          BigInt    @id @default(autoincrement())
  period      String // hourly, daily
  emailsSent  Int       @default(0) @map("emails_sent")
  maxEmails   Int       @map("max_emails")
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@index([period, periodStart, periodEnd])
  @@map("email_rate_limits")
}

model WebsiteVisit {
  id               BigInt    @id @default(autoincrement())
  sessionId        String    @map("session_id")
  userId           BigInt?   @map("user_id")
  ipAddress        String    @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  pageUrl          String    @map("page_url") @db.VarChar(500)
  pageTitle        String?   @map("page_title")
  referrer         String?   @db.VarChar(500)
  utmSource        String?   @map("utm_source")
  utmMedium        String?   @map("utm_medium")
  utmCampaign      String?   @map("utm_campaign")
  utmTerm          String?   @map("utm_term")
  utmContent       String?   @map("utm_content")
  timeOnPage       Int       @default(0) @map("time_on_page")
  isBounce         Boolean   @default(false) @map("is_bounce")
  deviceType       String?   @map("device_type") @db.VarChar(50)
  browser          String?   @db.VarChar(100)
  os               String?   @db.VarChar(100)
  screenResolution String?   @map("screen_resolution") @db.VarChar(20)
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt, ipAddress])
  @@index([userId, createdAt])
  @@map("website_visits")
}

model VisitorLocation {
  id             BigInt    @id @default(autoincrement())
  sessionId      String    @map("session_id")
  userId         BigInt?   @map("user_id")
  ipAddress      String    @map("ip_address") @db.VarChar(45)
  countryCode    String?   @map("country_code") @db.VarChar(2)
  countryName    String?   @map("country_name") @db.VarChar(100)
  regionCode     String?   @map("region_code") @db.VarChar(10)
  regionName     String?   @map("region_name") @db.VarChar(100)
  city           String?   @db.VarChar(100)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  timezone       String?   @db.VarChar(50)
  isp            String?   @db.VarChar(200)
  organization   String?   @db.VarChar(200)
  asNumber       String?   @map("as_number") @db.VarChar(20)
  locationSource String    @default("ip") @map("location_source") @db.VarChar(20)
  accuracy       Int?
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionId, ipAddress])
  @@index([sessionId])
  @@index([userId])
  @@index([ipAddress])
  @@index([countryCode])
  @@index([city])
  @@map("visitor_locations")
}

model PagePerformance {
  id                     BigInt    @id @default(autoincrement())
  sessionId              String    @map("session_id")
  pageUrl                String    @map("page_url") @db.VarChar(500)
  loadTime               Int?      @map("load_time")
  domReadyTime           Int?      @map("dom_ready_time")
  firstPaint             Int?      @map("first_paint")
  largestContentfulPaint Int?      @map("largest_contentful_paint")
  cumulativeLayoutShift  Decimal?  @map("cumulative_layout_shift") @db.Decimal(5, 3)
  firstInputDelay        Int?      @map("first_input_delay")
  connectionType         String?   @map("connection_type") @db.VarChar(20)
  createdAt              DateTime? @map("created_at")
  updatedAt              DateTime? @map("updated_at")

  @@index([sessionId])
  @@map("page_performance")
}

model UserSession {
  id                 BigInt    @id @default(autoincrement())
  sessionId          String    @unique @map("session_id")
  userId             BigInt?   @map("user_id")
  ipAddress          String    @map("ip_address") @db.VarChar(45)
  firstVisit         DateTime  @map("first_visit")
  lastActivity       DateTime  @map("last_activity")
  pageViews          Int       @default(1) @map("page_views")
  totalTime          Int       @default(0) @map("total_time")
  isReturningVisitor Boolean   @default(false) @map("is_returning_visitor")
  entryPage          String?   @map("entry_page") @db.VarChar(500)
  exitPage           String?   @map("exit_page") @db.VarChar(500)
  createdAt          DateTime? @map("created_at")
  updatedAt          DateTime? @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_sessions")
}

model WebsiteEvent {
  id            BigInt    @id @default(autoincrement())
  sessionId     String    @map("session_id")
  userId        BigInt?   @map("user_id")
  eventType     String    @map("event_type") @db.VarChar(50)
  eventCategory String?   @map("event_category") @db.VarChar(50)
  eventAction   String    @map("event_action") @db.VarChar(100)
  eventLabel    String?   @map("event_label") @db.VarChar(200)
  eventValue    Int?      @map("event_value")
  pageUrl       String    @map("page_url") @db.VarChar(500)
  eventData     Json?     @map("event_data")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([eventType])
  @@index([eventType, createdAt])
  @@map("website_events")
}
