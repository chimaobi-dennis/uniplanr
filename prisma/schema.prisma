  updatedAt    DateTime? @map("updated_at")

  @@map("global_settings")
}

model HomeText {
  id            BigInt    @id @default(autoincrement())
  section1Text  String    @map("section1_text")
  section1Image String    @map("section1_image")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@map("hometext")
}

model CompanyInfo {
  id        BigInt    @id @default(autoincrement())
  name      String
  phone     String
  email     String
  address   String
  logo      String
  favicon   String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("company_infos")
}

model Country {
  id        BigInt    @id @default(autoincrement())
  name      String
  code      String
  timezone  String
  continent String
  phoneCode String    @map("phone_code")
  flag      String? // INFERRED
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("countries")
}

model LevelOfEducation {
  id        BigInt    @id @default(autoincrement())
  name      String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("levels_of_education")
}

model StudyDestination {
  id                    BigInt    @id @default(autoincrement())
  // LEGACY ODDITY: migration declares country_id as boolean (tinyint(1)) although the model treats it as a
  // countries.id reference. Kept as Int without FK so any value copies over.
  countryId             Int       @map("country_id")
  name                  String
  whyStudyDestination   String    @map("why_study_destination")
  applicationPortal     String    @map("application_portal")
  applicationSteps      String    @map("application_steps")
  // INFERRED from StudyDestinations model (model casts why_study_here/visa_steps/intakes to arrays)
  whyStudyHere          Json?     @map("why_study_here")
  visaSteps             Json?     @map("visa_steps")
  intakes               Json?
  applicationPeriodFrom String?   @map("application_period_from")
  applicationPeriodTo   String?   @map("application_period_to")
  image                 String?
  maxProgram            Int?      @map("max_program")
  studyPeriod           String?   @map("study_period")
  timezone              String?
  applicationCost       String?   @map("application_cost")
  currency              String?
  status                String?
  createdAt             DateTime? @map("created_at")
  updatedAt             DateTime? @map("updated_at")

  @@map("study_destinations")
}

model PaymentMethod {
  id          BigInt    @id @default(autoincrement())
  name        String
  description String
  image       String
  slug        String
  status      String
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("payment_methods")
}

model SubscriptionPlan {
  id          BigInt    @id @default(autoincrement())
  title       String
  subtitle    String
  slug        String    @unique
  price       String
  priceAmount String    @map("price_amount")
  currency    String
  description String
  recommended String    @default("false")
  popular     String    @default("false")
  icon        String
  features    String
  buttonText  String    @map("button_text")
  gradient    String
  bgColor     String    @map("bg_color")
  textColor   String    @map("text_color")
  borderColor String    @map("border_color")
  buttonColor String    @map("button_color")
  type        String    @default("app") // app, doc-writing, etc.
  feeId       String?   @map("fee_id") // INFERRED
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("subscription_plans")
}

model DocumentSubscription {
  id        BigInt    @id @default(autoincrement())
  name      String
  price     Decimal   @default(0.00) @db.Decimal(8, 2)
  duration  String // enum: monthly | annually
  benefits  String
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("document_subscriptions")
}

model FeeBreakdown {
  id        BigInt    @id @default(autoincrement())
  name      String
  cost      String
  details   String
  currency  String
  duration  String
  status    Boolean
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("fee-breakdown")
}

model PaymentOrder {
  id             BigInt    @id @default(autoincrement())
  productId      String    @map("product_id")
  type           String
  userId         BigInt    @map("user_id")
  status         Boolean
  // INFERRED from PaymentOrders model
  priceIds       String?   @map("price_ids")
  costCenter     String?   @map("cost_center")
  paymentId      String?   @map("payment_id")
  sessionId      String?   @map("sessionId")
  planId         String?   @map("plan_id")
  couponCode     String?   @map("coupon_code")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  couponId       BigInt?   @map("coupon_id")
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_orders")
}

// ───────────────────────── Programs / universities ─────────────────────────

model Program {
  id                   BigInt    @id @default(autoincrement())
  courseName           String    @map("course_name")
  courseCode           String    @default("") @map("course_code")
  programAbout         String?   @map("program_about")
  campusAbout          String?   @map("campus_about")
  studentLife          String?   @map("student_life")
  career               String?
  degreeCert           String?   @map("degree_cert")
  degreeRequirements   Json?     @map("degree_requirements")
  documentRequirements Json?     @map("document_requirements")
  jobOpp               String?   @map("job_opp")
  youtubeLink          String?   @map("youtube_link")
  programStartDate     DateTime? @map("program_start_date")
  programEndDate       DateTime? @map("program_end_date")
  SI                   String?   @map("SI")
  keywords             Json?
  country              String
  universityName       String    @map("university_name")
  city                 String
  scholarship          String
  level                String
  duration             String
  image                String
  startDate            DateTime? @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  timezone             String?
  currency             String?
  tuition              Decimal?  @db.Decimal(8, 2)
  lateApp              Boolean   @default(false) @map("late_app")
  status               Boolean   @default(true)
  // INFERRED from Programs model ($fillable/$casts) - no migration creates these
  name                 String?
  lateEndDate          DateTime? @map("late_end_date")
  lateStartTime        DateTime? @map("late_start_time")
  firstTuition         Decimal?  @map("first_tuition") @db.Decimal(10, 2)
  totalTuition         Decimal?  @map("total_tuition") @db.Decimal(10, 2)
  universityId         BigInt?   @map("university_id") // plain column, FK not enforced (orphan risk)
  fieldOfStudy         String?   @map("field_of_study")
  studyPace            String?   @map("study_pace")
  uniLogo              String?   @map("uni_logo")
  uniRanking           String?   @map("uni_ranking")
  programLink          String?   @map("program_link")
  appLink              String?   @map("app_link")
  requirementsId       Json?     @map("requirements_id")
  maxProgram           Int?      @map("max_program")
  groupId              String?   @map("group_id")
  groupName            String?   @map("group_name")
  applicationDeadline  DateTime? @map("application_deadline")
  specificRequirements Json?     @map("specific_requirements")
  appSteps             Json?     @map("app_steps")
  appPortal            String?   @map("app_portal")
  countryId            BigInt?   @map("country_id")
  identifier           String?
  credit               String?
  language             String?
  studyPeriod          String?   @map("study_period")
  createdBy            BigInt?   @map("created_by")
  degreeRequirement    String?   @map("degree_requirement")
  degree               String?
  createdAt            DateTime? @map("created_at")
  updatedAt            DateTime? @map("updated_at")

  comments         ProgramComment[]
  ratings          ProgramRating[]
  favorites        FavoriteProgram[]
  documents        Document[]
  requirements     ProgramRequirement[]
  applicationLinks ProgramApplicationProgram[]
  recommendations  RecommendedProgram[]

  @@map("programs")
}

// INFERRED pivot (Programs::requirements belongsToMany 'program_requirements'); no migration exists.
model ProgramRequirement {
  programId     BigInt    @map("program_id")
  requirementId BigInt    @map("requirement_id")
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([programId, requirementId])
  @@map("program_requirements")
}

model Requirement {
  id           BigInt    @id @default(autoincrement())
  name         String
  tag          String
  price        String
  status       String? // INFERRED
  instructions String? // INFERRED
  createdAt    DateTime? @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  programs ProgramRequirement[]

  @@map("requirements")
}

model University {
  id             BigInt    @id @default(autoincrement())
  name           String
  country        String
  city           Json
  ranking        String
  about          String // varchar(255)
  logo           String
  img1           String
  // INFERRED from Universities model
  universityCode String?   @map("university_code")
  partnership    String?
  images         Json?
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  @@map("universities")
}

model City {
  id        BigInt    @id @default(autoincrement())
  name      String
  about     String
  housing   Json
  shops     Json
  images    String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("cities")
}

model Scholarship {
  id                BigInt    @id @default(autoincrement())
  eligiblePrograms  Json      @map("eligible_programs")
  appStartDate      String    @map("app_start_date")
  appEndDate        String    @map("app_end_date")
  documents         Json
  eligibleCountries Json      @map("eligible_countries")
  name              String
  value             String
  status            Boolean
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  @@map("scholarships")
}

model ProgramSeeding {
  id               BigInt    @id @default(autoincrement())
  universityName   String    @map("university_name")
  universityCode   String    @map("university_code")
  country          String
  countryCode      String    @map("country_code")
  city             String
  courseName       String    @map("course_name")
  fieldOfStudy     String    @map("field_of_study")
  programAbout     String    @map("program_about")
  courseCode       String    @map("course_code")
  duration         String
  level            String
  studyPace        String    @map("study_pace")
  career           String
  degreeCert       String    @map("degree_cert")
  programLink      String    @map("program_link")
  programStartDate DateTime  @map("program_start_date") @db.Date
  programEndDate   DateTime  @map("program_end_date") @db.Date
  firstTuition     Decimal   @map("first_tuition") @db.Decimal(10, 2)
  totalTuition     Decimal   @map("total_tuition") @db.Decimal(10, 2)
  requirements     Json
  currency         String
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  @@map("program_seedings")
}

model ProgramScraper {
  id               BigInt    @id @default(autoincrement())
  courseName       String?   @map("course_name")
  countryCode      String?   @map("country_code")
  universityCode   String?   @map("university_code")
  fieldOfStudy     String?   @map("field_of_study")
  programAbout     String?   @map("program_about")
  courseCode       String?   @map("course_code")
  duration         String?
  level            String?
  studyPace        String?   @map("study_pace")
  career           String?
  degreeCert       String?   @map("degree_cert")
  programLink      String?   @map("program_link")
  programStartDate DateTime? @map("program_start_date") @db.Date
  programEndDate   DateTime? @map("program_end_date") @db.Date
  firstTuition     Decimal?  @map("first_tuition") @db.Decimal(8, 2)
  totalTuition     Decimal?  @map("total_tuition") @db.Decimal(8, 2)
  requirements     Json?
  images           Json?
  aiContent        Json?     @map("ai_content") // INFERRED (ProgramScraper model)
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  @@map("program_scrapers")
}

model SiProgram {
  id             BigInt    @id @default(autoincrement())
  universityName String    @map("university_name")
  programName    String    @map("program_name")
  courseCode     String    @unique @map("course_code")
  credits        Int
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")

  @@index([universityName])
  @@map("s_i_programs")
}

model ProgramRating {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  programId BigInt    @map("program_id")
  rating    Int       @db.SmallInt // 1-5
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_ratings")
}

model FavoriteProgram {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  programId BigInt    @map("program_id")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("favorite_programs")
}

// recommended_programs: the migration creates an OLD shape (string user_id, app_trx, img1.., etc.) but
// later migrations/model reference a NEW shape (program_id, ai_score, rank, ...) that no migration creates.
// Modelled as the NEW shape (RecommendedProgram model); old text columns are treated as dead.
model RecommendedProgram {
  id               BigInt    @id @default(autoincrement())
  programId        BigInt    @map("program_id")
  userId           BigInt    @map("user_id")
  profileId        BigInt?   @map("profile_id")
  aiScore          Decimal?  @map("ai_score") @db.Decimal(5, 2)
  systemScore      Decimal   @default(0) @map("system_score") @db.Decimal(5, 2)
  rank             Int?
  aiExplanation    String?   @map("ai_explanation")
  matchingKeywords Json?     @map("matching_keywords")
  status           Int?
  creditUsed       Decimal   @default(0) @map("credit_used") @db.Decimal(10, 4)
  creditCost       Decimal   @default(0) @map("credit_cost") @db.Decimal(10, 8)
  createdAt        DateTime? @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  program Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StudentProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@map("recommended_programs")
}

// ───────────────────────── Applications ─────────────────────────

// Legacy NOT NULL form columns (fname, email, phone, ...) are RELAXED to nullable because the model no
// longer fills them. Columns after the "INFERRED" marker come from SubmitApplication model.
model Application {
  id                     BigInt    @id @default(autoincrement())
  userId                 BigInt    @map("user_id")
  fname                  String?
  email                  String?
  phone                  String?
  country                String?
  eduLevel               String?   @map("eduLevel")
  studyField             String?   @map("studyField")
  degree                 String?
  uniCountry             String?   @map("uniCountry")
  certCountry            String?   @map("certCountry")
  language               String?
  isEnglish              String?   @map("isEnglish")
  experience             String?
  yearsOfExp             String?   @map("yearsOfExp")
  preferedCountry        String?   @map("preferedCountry")
  countryPref            String?   @map("countryPref")
  feePref                String?   @map("feePref")
  doc1Name               String?   @map("doc1Name")
  doc2Name               String?   @map("doc2Name")
  doc3Name               String?   @map("doc3Name")
  status                 Boolean   @default(false) // legacy: boolean; model may store other values
  // INFERRED
  profileId              BigInt?   @map("profile_id")
  countryId              Json?     @map("country_id")
  studyDestination       String?   @map("study_destination")
  studyDestinationId     Json?     @map("study_destination_id")
  trx                    String?
  stage                  String?
  paymentId              String?   @map("payment_id")
  subscriptionPlan       String?   @map("subscription_plan")
  paymentStatus          String?   @map("payment_status")
  progress               String?
  applicationLogin       String?   @map("application_login")
  applicationPassword    String?   @map("application_password")
  maxProgram             Int?      @map("max_program")
  timezone               String?
  applicationPeriodFrom  String?   @map("application_period_from")
  applicationPeriodTo    String?   @map("application_period_to")
  university             String?
  emailNotification      String?   @map("email_notification")
  studyPeriod            String?   @map("study_period")
  recommended            String?
  selectedPrograms       String?   @map("selected_programs")
  track                  String?
  addedDocuments         Json?     @map("added_documents")
  admittedPrograms       Json?     @map("admitted_programs")
  acceptedAdmission      String?   @map("accepted_admission")
  rejectedPrograms       Json?     @map("rejected_programs")
  rejectedAdmission      Json?     @map("rejected_admission")
