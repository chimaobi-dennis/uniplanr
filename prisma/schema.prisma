  versions       DocumentVersion[] @relation("VersionDocument")
  shares         DocumentShare[]
  aiLogs         AiGenerationLog[]

  @@unique([applicationId, programId, category])
  @@index([applicationId, programId])
  @@index([folderId])
  @@map("documents")
}

// DRIFT: Document model uses columns `version`, `user_id`, `change_description`; the migration has
